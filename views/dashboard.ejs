<%- include('./partials/head') %>

<% if (flash) { %>
  <div class="flash <%= flashType === 'error' ? 'flash-error' : '' %>"><%= flash %></div>
<% } %>

<div class="grid-4">
  <div class="card">
    <div class="metric-label">Available Cash</div>
    <div class="metric-value">₹<%= Number(funds.availablecash).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
  </div>
  <div class="card">
    <div class="metric-label">Utilised Margin</div>
    <div class="metric-value">₹<%= Number(funds.utiliseddebits).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
  </div>
  <div class="card">
    <div class="metric-label">Unrealized M2M</div>
    <div class="metric-value <%= Number(funds.m2munrealized) >= 0 ? 'text-green' : 'text-red' %>">
      ₹<%= Number(funds.m2munrealized).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
    </div>
  </div>
  <div class="card">
    <div class="metric-label">Realized M2M</div>
    <div class="metric-value <%= Number(funds.m2mrealized) >= 0 ? 'text-green' : 'text-red' %>">
      ₹<%= Number(funds.m2mrealized).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Quick Order Ticket</h2>
      <span class="badge <%= analyzeMode ? 'badge-amber' : 'badge-green' %>">
        <%= analyzeMode ? 'Sandbox Execution' : 'Live Broker' %>
      </span>
    </div>
    <form method="post" action="/orders/quick">
      <div class="form-grid">
        <div>
          <label for="exchange">Exchange</label>
          <select id="exchange" name="exchange">
            <option value="NSE">NSE</option>
            <option value="BSE">BSE</option>
            <option value="NFO">NFO</option>
            <option value="MCX">MCX</option>
            <option value="CRYPTO">CRYPTO</option>
          </select>
        </div>
        <div>
          <label for="symbol">Symbol</label>
          <input id="symbol" name="symbol" value="SBIN" required />
        </div>
        <div>
          <label for="action">Action</label>
          <select id="action" name="action">
            <option value="BUY">BUY</option>
            <option value="SELL">SELL</option>
          </select>
        </div>
        <div>
          <label for="quantity">Quantity</label>
          <input id="quantity" name="quantity" type="number" min="1" value="10" required />
        </div>
        <div>
          <label for="product">Product</label>
          <select id="product" name="product">
            <option value="MIS">MIS</option>
            <option value="CNC">CNC</option>
            <option value="NRML">NRML</option>
          </select>
        </div>
        <div>
          <label for="pricetype">Price Type</label>
          <select id="pricetype" name="pricetype">
            <option value="MARKET">MARKET</option>
            <option value="LIMIT">LIMIT</option>
            <option value="SL">SL</option>
            <option value="SL-M">SL-M</option>
          </select>
        </div>
        <div>
          <label for="price">Price (0 = Market)</label>
          <input id="price" name="price" type="number" step="0.05" value="0" />
        </div>
        <div>
          <label for="strategy">Strategy</label>
          <input id="strategy" name="strategy" value="Dashboard" />
        </div>
      </div>
      <div style="margin-top: 14px; display: flex; gap: 10px; align-items: center;">
        <button type="submit" class="btn">Place Order</button>
        <span class="text-muted" style="font-size:12px;">Order Mode: <strong><%= orderMode %></strong></span>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Live Market Watch</h2>
      <a href="/playground" class="btn btn-secondary btn-sm">Query /api/v1/quotes</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Exchange</th>
            <th class="num">LTP</th>
            <th class="num">Open</th>
            <th class="num">High / Low</th>
          </tr>
        </thead>
        <tbody>
          <% for (const q of sampleQuotes) { %>
            <tr>
              <td class="mono"><strong><%= q.symbol %></strong></td>
              <td><span class="exch-tag"><%= q.exchange %></span></td>
              <td class="num <%= q.ltp >= q.prev_close ? 'text-green' : 'text-red' %>"><%= q.ltp.toFixed(2) %></td>
              <td class="num"><%= q.open.toFixed(2) %></td>
              <td class="num text-muted"><%= q.high.toFixed(2) %> / <%= q.low.toFixed(2) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Open Positions (<%= positions.length %>)</h2>
      <a href="/positions" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Product</th>
            <th class="num">Net Qty</th>
            <th class="num">Avg Price</th>
            <th class="num">LTP</th>
            <th class="num">P&amp;L</th>
          </tr>
        </thead>
        <tbody>
          <% if (positions.length === 0) { %>
            <tr><td colspan="6" class="text-muted">No open positions</td></tr>
          <% } %>
          <% for (const p of positions) { %>
            <tr>
              <td class="mono"><strong><%= p.symbol %></strong> <span class="exch-tag"><%= p.exchange %></span></td>
              <td><%= p.product %></td>
              <td class="num"><%= p.quantity %></td>
              <td class="num"><%= p.average_price.toFixed(2) %></td>
              <td class="num"><%= p.ltp.toFixed(2) %></td>
              <td class="num <%= p.pnl >= 0 ? 'text-green' : 'text-red' %>"><%= p.pnl.toFixed(2) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Recent Orders (<%= orderStats.total_completed_orders %> filled / <%= orderStats.total_open_orders %> open)</h2>
      <a href="/orderbook" class="btn btn-secondary btn-sm">Orderbook</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Symbol</th>
            <th>Side</th>
            <th class="num">Qty</th>
            <th class="num">Price</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentOrders.length === 0) { %>
            <tr><td colspan="5" class="text-muted">No orders yet</td></tr>
          <% } %>
          <% for (const o of recentOrders) { %>
            <tr>
              <td class="mono"><%= o.symbol %> <span class="exch-tag"><%= o.exchange %></span></td>
              <td>
                <span class="badge <%= o.action === 'BUY' ? 'badge-green' : 'badge-red' %>"><%= o.action %></span>
              </td>
              <td class="num"><%= o.quantity %></td>
              <td class="num"><%= o.price.toFixed(2) %></td>
              <td>
                <span class="badge <%= o.order_status === 'complete' ? 'badge-green' : o.order_status === 'open' ? 'badge-blue' : 'badge-red' %>">
                  <%= o.order_status %>
                </span>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('./partials/foot') %>
