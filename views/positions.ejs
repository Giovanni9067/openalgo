<%- include('./partials/head') %>

<% if (flash) { %>
  <div class="flash"><%= flash %></div>
<% } %>

<div class="grid-4">
  <div class="card">
    <div class="metric-label">Unrealized M2M</div>
    <div class="metric-value <%= Number(funds.m2munrealized) >= 0 ? 'text-green' : 'text-red' %>">
      ₹<%= Number(funds.m2munrealized).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
    </div>
  </div>
  <div class="card">
    <div class="metric-label">Realized M2M</div>
    <div class="metric-value <%= Number(funds.m2mrealized) >= 0 ? 'text-green' : 'text-red' %>">
      ₹<%= Number(funds.m2mrealized).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
    </div>
  </div>
  <div class="card">
    <div class="metric-label">Available Cash</div>
    <div class="metric-value">₹<%= Number(funds.availablecash).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Positions (<%= positions.length %>)</h2>
    <div style="display:flex; gap:8px;">
      <a href="/positions/export" class="btn btn-secondary btn-sm">Export CSV</a>
      <form method="post" action="/positions/close" style="display:inline;">
        <button type="submit" class="btn btn-danger btn-sm">Square Off All</button>
      </form>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Exchange</th>
          <th>Product</th>
          <th class="num">Net Qty</th>
          <th class="num">Avg Price</th>
          <th class="num">LTP</th>
          <th class="num">P&amp;L</th>
        </tr>
      </thead>
      <tbody>
        <% if (positions.length === 0) { %>
          <tr><td colspan="7" class="text-muted">No positions recorded.</td></tr>
        <% } %>
        <% for (const p of positions) { %>
          <tr>
            <td class="mono"><strong><%= p.symbol %></strong></td>
            <td><span class="exch-tag"><%= p.exchange %></span></td>
            <td><%= p.product %></td>
            <td class="num"><%= p.quantity %></td>
            <td class="num"><%= p.average_price.toFixed(2) %></td>
            <td class="num"><%= p.ltp.toFixed(2) %></td>
            <td class="num <%= p.pnl >= 0 ? 'text-green' : 'text-red' %>"><%= p.pnl.toFixed(2) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('./partials/foot') %>
