<%- include('./partials/head') %>

<% if (flash) { %>
  <div class="flash"><%= flash %></div>
<% } %>

<div class="grid-2" style="margin-bottom:18px;">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Sandbox Capital</h2>
      <form method="post" action="/sandbox/reset">
        <button type="submit" class="btn btn-danger btn-sm">Reset Sandbox Books</button>
      </form>
    </div>
    <div class="metric-label">Current Available Cash</div>
    <div class="metric-value">₹<%= Number(funds.availablecash).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Sandbox Configuration</h2>
  </div>
  <form method="post" action="/sandbox/config">
    <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
      <% for (const item of configs) { %>
        <div>
          <label for="cfg_<%= item.key %>"><%= item.description %></label>
          <input id="cfg_<%= item.key %>" name="<%= item.key %>" value="<%= item.value %>" class="mono" />
        </div>
      <% } %>
    </div>
    <div style="margin-top:16px;">
      <button type="submit" class="btn">Save Configuration</button>
    </div>
  </form>
</div>

<%- include('./partials/foot') %>
