<%- include('./partials/head') %>

<% if (flash) { %>
  <div class="flash"><%= flash %></div>
<% } %>

<div class="card" style="max-width:480px; margin:20px auto;">
  <div class="card-header">
    <h2 class="card-title"><%= mode === 'setup' ? 'Initial Admin Setup' : 'OpenAlgo Trader Session' %></h2>
    <span class="badge badge-blue">In-Memory Session</span>
  </div>

  <% if (mode === 'setup') { %>
    <form method="post" action="/setup" style="display:grid; gap:12px;">
      <div>
        <label for="username">Admin Username</label>
        <input id="username" name="username" value="<%= user.username %>" required />
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= user.email %>" required />
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" value="openalgo-demo" required />
      </div>
      <button type="submit" class="btn">Save Admin Account</button>
    </form>
  <% } else { %>
    <form method="post" action="/auth/login" style="display:grid; gap:12px;">
      <div>
        <label for="username">Username</label>
        <input id="username" name="username" value="<%= user.username %>" required />
      </div>
      <div>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" value="openalgo-demo" required />
      </div>
      <div style="display:flex; gap:10px;">
        <button type="submit" class="btn">Sign In</button>
        <a href="/setup" class="btn btn-secondary">Setup Admin</a>
      </div>
    </form>
  <% } %>
</div>

<%- include('./partials/foot') %>
