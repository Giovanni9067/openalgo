<aside class="sidebar">
  <div class="brand">
    <span class="brand-title">OpenAlgo</span>
    <span class="brand-ver">v2.0.1</span>
  </div>

  <div class="nav-group">
    <div class="nav-label">Trading</div>
    <a class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
    <a class="nav-link <%= page === 'orderbook' ? 'active' : '' %>" href="/orderbook">Orderbook</a>
    <a class="nav-link <%= page === 'tradebook' ? 'active' : '' %>" href="/tradebook">Tradebook</a>
    <a class="nav-link <%= page === 'positions' ? 'active' : '' %>" href="/positions">Positions</a>
    <a class="nav-link <%= page === 'holdings' ? 'active' : '' %>" href="/holdings">Holdings</a>
    <a class="nav-link <%= page === 'action-center' ? 'active' : '' %>" href="/action-center">
      <span>Action Center</span>
      <% if (pendingCount > 0) { %>
        <span class="badge badge-amber"><%= pendingCount %></span>
      <% } %>
    </a>
  </div>

  <div class="nav-group">
    <div class="nav-label">Platform &amp; API</div>
    <a class="nav-link <%= page === 'broker' ? 'active' : '' %>" href="/broker">Brokers (39)</a>
    <a class="nav-link <%= page === 'apikey' ? 'active' : '' %>" href="/apikey">API Key</a>
    <a class="nav-link <%= page === 'sandbox' ? 'active' : '' %>" href="/sandbox">Sandbox</a>
    <a class="nav-link <%= page === 'analyzer' ? 'active' : '' %>" href="/analyzer">Analyzer Logs</a>
    <a class="nav-link <%= page === 'playground' ? 'active' : '' %>" href="/playground">API Playground</a>
    <a class="nav-link <%= page === 'flow' ? 'active' : '' %>" href="/flow">Flow Automation</a>
  </div>

  <div class="nav-group" style="margin-top:auto;">
    <div class="nav-label">Account</div>
    <a class="nav-link <%= page === 'login' ? 'active' : '' %>" href="/login">Session (<%= user.username %>)</a>
  </div>
</aside>
